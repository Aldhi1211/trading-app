# ── Telegram (required) ────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# ── Trading config ─────────────────────────────────────────────────────────
SYMBOL=BTCUSDT
INTERVAL=1m
INITIAL_BALANCE_USDT=1000

# Fallback % stops — used only when ATR-based risk is OFF or ATR is unavailable.
TAKE_PROFIT_PCT=0.02           # 2% take profit
STOP_LOSS_PCT=0.01             # 1% stop loss

# ── ATR-based risk management (volatility-adaptive) ─────────────────────────
USE_ATR_RISK=true              # scale stop/target with volatility instead of fixed %
ATR_SL_MULT=1.5                # stop  = entry - 1.5 * ATR
ATR_TP_MULT=3.0                # target = entry + 3.0 * ATR  (2:1 reward:risk)

USE_TRAILING_STOP=true         # let winners run via a trailing stop
TRAIL_ATR_MULT=1.5             # trail the peak by 1.5 * ATR
BREAKEVEN_AT_R=1.0             # move stop to breakeven once profit reaches +1R

# ── Position sizing ────────────────────────────────────────────────────────
# POSITION_SIZING_MODE: 'risk' (recommended) | 'percent' | 'fixed'
POSITION_SIZING_MODE=risk
RISK_PER_TRADE_PCT=0.01        # mode=risk: risk 1% of equity to the stop per trade
MAX_ALLOCATION_PCT=0.95        # mode=risk: never deploy more than 95% of balance
TRADE_ALLOCATION_PCT=0.95      # mode=percent: allocate 95% of balance
POSITION_FIXED_USDT=950        # mode=fixed: always allocate this USDT amount

# ── Entry-quality filters ───────────────────────────────────────────────────
VOL_MA_MULT=1.0                # require entry volume >= 1.0 * avg volume (0 = off)
MIN_ATR_PCT=0                  # require ATR/price >= this, skip dead markets (0 = off)
ENTRY_COOLDOWN_BARS=3          # after a losing trade, skip entries for N candles (0 = off)

# ── Indicator parameters ───────────────────────────────────────────────────
RSI_PERIOD=14
RSI_OVERSOLD=35
RSI_OVERBOUGHT=70
RSI_BUY_MIN=40                 # buy only when RSI is between these bounds
RSI_BUY_MAX=65
EMA_FAST_PERIOD=9
EMA_SLOW_PERIOD=21

# ── Database ───────────────────────────────────────────────────────────────
DB_PATH=./data/trading.db

# ── Logging ────────────────────────────────────────────────────────────────
LOG_LEVEL=info
