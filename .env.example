# ── Telegram (required) ────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# ── Trading config ─────────────────────────────────────────────────────────
SYMBOL=BTCUSDT
INTERVAL=1m
INITIAL_BALANCE_USDT=1000
TAKE_PROFIT_PCT=0.02           # 2% take profit
STOP_LOSS_PCT=0.01             # 1% stop loss

# ── Position sizing ────────────────────────────────────────────────────────
# POSITION_SIZING_MODE: 'percent' (default) or 'fixed'
POSITION_SIZING_MODE=percent
TRADE_ALLOCATION_PCT=0.95      # used when mode=percent: allocate 95% of balance
POSITION_FIXED_USDT=950        # used when mode=fixed: always allocate this USDT amount

# ── Indicator parameters ───────────────────────────────────────────────────
RSI_PERIOD=14
RSI_OVERSOLD=35
RSI_OVERBOUGHT=70
EMA_FAST_PERIOD=9
EMA_SLOW_PERIOD=21

# ── Database ───────────────────────────────────────────────────────────────
DB_PATH=./data/trading.db

# ── Logging ────────────────────────────────────────────────────────────────
LOG_LEVEL=info
