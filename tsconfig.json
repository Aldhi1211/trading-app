{
  "compilerOptions": {
    "target":                          "ES2022",
    "module":                          "NodeNext",
    "moduleResolution":                "NodeNext",
    "lib":                             ["ES2022", "ES2023"],
    "outDir":                          "./dist",
    "rootDir":                         "./src",

    "strict":                          true,
    "noUncheckedIndexedAccess":        true,
    "exactOptionalPropertyTypes":      true,
    "noImplicitReturns":               true,
    "noFallthroughCasesInSwitch":      true,
    "forceConsistentCasingInFileNames":true,

    "verbatimModuleSyntax":            true,
    "esModuleInterop":                 true,
    "skipLibCheck":                    true,

    "declaration":                     true,
    "declarationMap":                  true,
    "sourceMap":                       true
  },
  "include":  ["src/**/*"],
  "exclude":  ["node_modules", "dist", "src/backtest.ts", "src/backtest-ideas.ts"]
}
